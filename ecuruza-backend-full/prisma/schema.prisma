generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
  OPERATOR
}

enum RefreshTokenStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(BUYER)
  profileName  String?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  emailVerifications EmailVerification[]
  otps         OTP[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  status    RefreshTokenStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  code      String
  purpose   String   // VERIFY_EMAIL or PASSWORD_RESET
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OTP {
  id        String   @id @default(uuid())
  userId    String?
  phone     String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Subscription {
  id        String   @id @default(uuid())
  sellerId  String?
  planCode  String
  status    String
  startedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id         String   @id @default(uuid())
  reference  String   @unique
  amount     Decimal
  currency   String
  status     String
  payload    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
